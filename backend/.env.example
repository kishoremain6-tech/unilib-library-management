# Copy this file to ".env" and fill in your own values. Never commit .env.
PORT=5000
NODE_ENV=development

# Local MongoDB:
MONGODB_URI=mongodb://127.0.0.1:27017/unilib
# MongoDB Atlas example (replace user, password, cluster):
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/unilib?retryWrites=true&w=majority

# Long random string. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_DAYS=1

# Library rules (enforced on the server)
LOAN_DAYS=3
FINE_PER_DAY=10
MAX_ACTIVE_BORROWS=5
